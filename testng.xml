<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!-- TestNG suite run by `mvn test` (configured in the surefire plugin in pom.xml). Add new test classes under <classes>. -->
<suite name="API Automation Suite">
  <listeners>
    <!-- Writes api-test-report.html to the TestNG output directory -->
    <listener class-name="com.automation.api.listeners.HtmlReportListener"/>
  </listeners>
  <test thread-count="5" name="Test">
    <classes>
      <class name="com.automation.api.tests.CommentTest"/>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
